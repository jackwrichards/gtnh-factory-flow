# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.browser-test.local/
/.icon-sizing-results.local/
/.pipeline
/.tmp
/.gh-artifacts-*/
*.tar
/public/datasets/gtnh/

# agent scratch: screenshots, probes, captures, logs (local only, see AGENTS.md)
/scratch/
/.worktrees/
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.svg
/*.local.*
!/vitest.local.config.ts

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log
.deploy-exotiserver*.sh

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/highs.wasm
public/highs.js
tools/parity/out/

# the live service bundle (npm run build:live)
/dist-live/

# JetBrains IDEs
.idea/
